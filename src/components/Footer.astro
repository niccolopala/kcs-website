---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink">
  <div class="container-kcs grid gap-10 py-14 text-sm text-muted sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-3">
      <img src="/logo.svg" alt={site.name} width="155" height="48" class="h-12 w-auto self-start" loading="lazy" />
      <address class="not-italic leading-relaxed">
        {site.address.line1}<br />
        {site.address.line2}, {site.address.town}<br />
        {site.address.county} {site.address.postcode}
      </address>
      <span>{site.hours}</span>
    </div>
    <div class="flex flex-col gap-2">
      <strong class="text-white">Studios</strong>
      <a href="/podcast-studio" class="text-muted hover:text-white">Podcast Studio</a>
      <a href="/infinity-room" class="text-muted hover:text-white">White Infinity Room</a>
      <a href="/kitchen-studio" class="text-muted hover:text-white">Kitchen Studio (coming soon)</a>
    </div>
    <div class="flex flex-col gap-2">
      <strong class="text-white">Get in touch</strong>
      <a href={`mailto:${site.email}`} class="text-muted hover:text-white">{site.email}</a>
      <a href={site.instagram} class="text-muted hover:text-white" rel="noopener" target="_blank">{site.instagramHandle}</a>
      <a href="/faq" class="text-muted hover:text-white">FAQ</a>
    </div>
    <div class="flex flex-col gap-3">
      <strong class="text-white">Join the list</strong>
      <span>Open slots, launch offers and the kitchen studio opening. No spam.</span>
      <!-- Netlify Forms: submissions appear under Forms in the Netlify dashboard as "mailing-list". -->
      <form
        name="mailing-list"
        method="POST"
        action="/thanks"
        data-netlify="true"
        netlify-honeypot="company-website"
        class="flex flex-col gap-2"
      >
        <input type="hidden" name="form-name" value="mailing-list" />
        <p class="hidden"><label>Leave this empty <input name="company-website" /></label></p>
        <label for="footer-email" class="sr-only">Email address</label>
        <div class="flex gap-2">
          <input
            id="footer-email"
            type="email"
            name="email"
            required
            autocomplete="email"
            placeholder="you@company.com"
            class="min-w-0 flex-1 rounded-lg border border-[#333] bg-panel px-3 py-3 text-white placeholder:text-muted"
          />
          <button type="submit" class="btn shrink-0 bg-red px-4 text-white hover:bg-red-bright">Join</button>
        </div>
      </form>
    </div>
  </div>
  <div class="container-kcs border-t border-line py-6 text-xs text-muted">
    © {year} {site.name}. All prices exclude VAT.
  </div>
</footer>
