---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';

// Update this date whenever the policy changes.
const updated = '5 November 2026';

const sections: { h: string; id?: string; body: string[] }[] = [
  {
    h: 'Who we are',
    body: [
      `Kent Content Studios Ltd ("KCS", "we", "us") runs the studios at ${site.address.line1}, ${site.address.line2}, ${site.address.town}, ${site.address.county} ${site.address.postcode}. We are responsible for the personal information you give us through this website and when you book with us.`,
      `If you have any questions about this policy or your information, email ${site.email}.`,
    ],
  },
  {
    h: 'What we collect',
    body: [
      'Enquiries: your name, email address, company (if you give it) and your message.',
      'Mailing list and kitchen studio interest: your email address, and your name if you give it.',
      'Bookings: your name, email address, phone number, company, the number of people and cars you are bringing, and anything you tell us about access needs. Access needs can include health information; we only use it to make your visit work for you, and only if you choose to tell us.',
      'Payments: deposits are taken by our payment provider. We never see or store your full card details.',
    ],
  },
  {
    h: 'Cookies',
    id: 'cookies',
    body: [
      'We only set one kind of non-essential cookie: Google Ads cookies, which tell us when someone reached our site from one of our ads and then got in touch. They are only set if you click Accept on our cookie banner.',
      'If you decline, no advertising cookies are set and the site works exactly the same. We remember your choice in your browser so we do not keep asking. You can change your mind at any time with the "Cookie settings" link at the bottom of every page.',
      'We do not use any other analytics or tracking cookies.',
    ],
  },
  {
    h: 'How we use it and why',
    body: [
      'To reply to enquiries and arrange tours, because you asked us to (steps before a contract).',
      'To take, manage and deliver your booking, including invoices and your files (to perform our contract with you).',
      'To send our mailing list emails about open slots, offers and new studios, only because you signed up (consent). Every email has an unsubscribe link, and you can withdraw consent at any time.',
      'To keep financial records we are legally required to keep (legal obligation).',
    ],
  },
  {
    h: 'Who we share it with',
    body: [
      'We never sell your information. We share it only with the services that help us run KCS:',
      'Netlify (hosts this website and receives form submissions), Resend (sends us an email for each form submission), Cal.com (online booking), Google (advertising, only if you accept cookies), our payment provider (deposits), our email provider (business email) and, if you join our mailing list, the service we use to send it.',
      'Some of these providers store data outside the UK, including in the United States. Where they do, they protect it with the safeguards UK data protection law requires, such as the UK International Data Transfer Addendum or Standard Contractual Clauses.',
    ],
  },
  {
    h: 'How long we keep it',
    body: [
      'Enquiries that do not lead to a booking: up to 12 months.',
      'Booking and payment records: 6 years, as required for tax and accounting.',
      'Mailing list: until you unsubscribe.',
      'Raw footage from your session: 6 months, as set out in our FAQ.',
    ],
  },
  {
    h: 'Your rights',
    body: [
      `You can ask to see the information we hold about you, have it corrected or deleted, restrict or object to how we use it, or receive a copy to take elsewhere. Email ${site.email} and we will respond within one month.`,
      'If you are unhappy with how we have handled your information, you can complain to the Information Commissioner\'s Office (ICO) at ico.org.uk or on 0303 123 1113. We would appreciate the chance to put it right first.',
    ],
  },
];
---

<Base
  title="Privacy Policy | Kent Content Studios"
  description="How Kent Content Studios collects, uses and protects your personal information."
  current="/privacy"
>
  <section class="border-b border-line">
    <div class="container-kcs flex flex-col gap-4 pb-12 pt-20">
      <h1 class="heading-display text-6xl md:text-8xl">Privacy <span class="text-red">policy.</span></h1>
      <p class="text-muted">Last updated {updated}</p>
    </div>
  </section>

  <section class="bg-mist text-ink">
    <div class="container-kcs py-16 md:py-20"><div class="flex max-w-3xl flex-col gap-12">
      <p class="text-lg leading-relaxed text-body">
        This policy explains what personal information we collect when you use this website, contact us or book a
        session, what we do with it, and your rights. We keep it short and only collect what we need.
      </p>
      {
        sections.map((s) => (
          <div id={s.id} class="flex scroll-mt-28 flex-col gap-3">
            <h2 class="heading-display text-4xl">{s.h}</h2>
            {s.body.map((p) => (
              <p class="leading-relaxed text-body">{p}</p>
            ))}
          </div>
        ))
      }
    </div></div>
  </section>
</Base>
