---
import Base from '../layouts/Base.astro';
---

<Base title="Thanks | Kent Content Studios" description="Thanks for getting in touch with Kent Content Studios.">
  <section class="container-kcs flex min-h-[60vh] flex-col items-start justify-center gap-6 py-24">
    <h1 class="heading-display text-7xl md:text-[96px]">Got it. <span class="text-red">Thanks.</span></h1>
    <p class="max-w-xl text-lg leading-relaxed text-muted">We'll get back to you within one working day.</p>
    <a href="/" class="btn bg-red text-white hover:bg-red-bright">Back to home</a>
  </section>
</Base>
