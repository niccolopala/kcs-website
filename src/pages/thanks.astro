---
import Base from '../layouts/Base.astro';
// Landing page for the mailing list and Kitchen Studio forms. Fires no Google Ads conversion
// (enquiries go to /enquiry-thanks/, bookings to /booked/).
---

<Base title="Thanks | Kent Content Studios" description="Thanks for signing up to Kent Content Studios." noindex>
  <section class="container-kcs flex min-h-[60vh] flex-col items-start justify-center gap-6 py-24">
    <h1 class="heading-display text-7xl md:text-[96px]">You're <span class="text-red">in.</span></h1>
    <p class="max-w-xl text-lg leading-relaxed text-muted">Thanks for signing up. We'll be in touch with open slots, offers and studio news.</p>
    <a href="/" class="btn bg-red text-white hover:bg-red-bright">Back to home</a>
  </section>
</Base>
