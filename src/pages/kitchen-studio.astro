---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import kitchenBuild from '../assets/kitchen/kitchen-build.jpg';
import InterestForm from '../components/InterestForm.astro';
---

<Base
  title="Kitchen Studio, Coming Soon | Kent Content Studios"
  description="A kitchen studio for food and product content is coming to Kent Content Studios in Cranbrook. Register your interest to hear first when it opens."
  current="/kitchen-studio"
>
  <section style="background-image: radial-gradient(800px 420px at 50% 0%, rgba(192,40,30,0.12), transparent 70%)">
    <div class="container-kcs grid items-start gap-12 py-20 md:grid-cols-2 md:py-28">
      <div class="flex flex-col gap-5">
        <span class="self-start rounded-md bg-red px-2.5 py-1 text-[11px] font-bold tracking-wider">COMING SOON</span>
        <h1 class="heading-display text-7xl md:text-[96px]">Kitchen <span class="text-red">Studio.</span></h1>
        <p class="max-w-xl text-lg leading-relaxed text-muted">
          A dedicated kitchen set for food brands, recipe content and product demos is being built now. Book it as
          dry hire, or have our food videographer shoot it for you.
        </p>
        <div id="register" class="mt-2 flex scroll-mt-28 flex-col gap-4 rounded-lg border border-line-strong border-t-[3px] border-t-red bg-panel p-6">
          <div class="flex flex-col gap-1">
            <h2 class="heading-display text-4xl">Be first <span class="text-red">in.</span></h2>
            <p class="text-sm text-muted">Get opening dates and launch pricing before anyone else.</p>
          </div>
          <InterestForm
            name="kitchen-interest"
            topic="Kitchen Studio"
            showMessage={false}
            showCompany={false}
            submitLabel="Register interest"
            consent="We'll email you when the kitchen studio opens, plus the odd launch offer. Unsubscribe any time."
          />
        </div>
      </div>
      <Image
        src={kitchenBuild}
        alt="The Kitchen Studio under construction at Kent Content Studios, with a coming soon sign"
        widths={[600, 1000, 1400]}
        sizes="(min-width: 768px) 50vw, 100vw"
        loading="eager"
        class="aspect-video w-full rounded-lg object-cover"
      />
    </div>
  </section>

</Base>
