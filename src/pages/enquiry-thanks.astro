---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base title="Thanks for your enquiry | Kent Content Studios" description="Thanks for your enquiry to Kent Content Studios." noindex>
  <section class="container-kcs flex min-h-[60vh] flex-col items-start justify-center gap-6 py-24">
    <h1 class="heading-display text-7xl md:text-[96px]">Got it. <span class="text-red">Thanks.</span></h1>
    <p class="max-w-xl text-lg leading-relaxed text-muted">We've got your enquiry and we'll get back to you within one working day.</p>
    <a href="/" class="btn bg-red text-white hover:bg-red-bright">Back to home</a>
  </section>
</Base>

<script is:inline define:vars={{ conversion: site.googleAdsEnquiryConversion }}>
  // Counts an enquiry as a Google Ads conversion. Consent Mode decides what Google may store.
  (function () {
    if (conversion && window.gtag) window.gtag('event', 'conversion', { send_to: conversion });
  })();
</script>
